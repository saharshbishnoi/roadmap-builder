{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadmap Builder",
  "version": "1.2.0",
  "identifier": "app.roadmapbuilder.desktop",
  "build": {
    "frontendDist": "../site"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Roadmap Builder", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "An intuitive, interactive roadmap view",
    "longDescription": "Roadmap Builder keeps a whole programme on one timeline. Roadmaps are kept on this computer; nothing is sent anywhere.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
